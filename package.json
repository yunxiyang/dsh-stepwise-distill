{
  "name": "dsh-stepwise-distill",
  "version": "0.2.0",
  "description": "Solidify DSH session history step by step: rewrite tool results in place to the facts the model actually kept, so long conversations stop re-sending noise every turn. Costs tokens and time: a ~770-character contract in every request, plus one extra full-context request and round-trip per step when stepSummary is on.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "context",
    "history",
    "distill",
    "token"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunxiyang/dsh-stepwise-distill.git"
  },
  "homepage": "https://github.com/yunxiyang/dsh-stepwise-distill#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./distill": {
      "types": "./lib/distill.d.ts",
      "default": "./lib/distill.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/distill.js",
    "lib/distill.d.ts",
    "lib/summarize.js",
    "lib/summarize.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-sync.mjs",
    "link-host-deps": "node scripts/link-host-deps.mjs",
    "postinstall": "node scripts/link-host-deps.mjs --optional",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
